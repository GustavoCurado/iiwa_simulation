<?xml version="1.0" ?>
<!-- ===================================================================== -->
<!-- URDF à prova de balas: Matemática iLQR + Malhas STL (iiwa-stack)      -->
<!-- ===================================================================== -->
<robot name="iiwa14">
  
  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base"/>
  </joint>

  <link name="base"/>
  
  <joint name="iiwa_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base"/>
    <child link="iiwa_link_0"/>
  </joint>
  
  <link name="iiwa_link_0">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.1 0 0.07"/>
      <mass value="5"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.03"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://iiwa_simulation/meshes/iiwa14/visual/link_0.stl"/>
      </geometry>
      <material name="Grey"><color rgba="0.4 0.4 0.4 1.0"/></material>
    </visual>
  </link>

  <joint name="iiwa_joint_1" type="revolute">
    <parent link="iiwa_link_0"/>
    <child link="iiwa_link_1"/>
    <origin rpy="0 0 0" xyz="0 0 0.1575"/>
    <axis xyz="0 0 1"/>
    <limit effort="300" lower="-2.96705972839" upper="2.96705972839" velocity="10"/>
    <dynamics damping="0.5"/>
  </joint>
  
  <link name="iiwa_link_1">
    <inertial>
      <origin rpy="0 0 0" xyz="0 -0.03 0.12"/>
      <mass value="5.76"/>
      <inertia ixx="0.121" ixy="0" ixz="0" iyy="0.116" iyz="-0.021" izz="0.0175"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://iiwa_simulation/meshes/iiwa14/visual/link_1.stl"/>
      </geometry>
      <material name="Orange"><color rgba="1.0 0.42 0.04 1.0"/></material>
    </visual>
  </link>

  <joint name="iiwa_joint_2" type="revolute">
    <parent link="iiwa_link_1"/>
    <child link="iiwa_link_2"/>
    <origin rpy="1.570796326794897 0 3.141592653589793" xyz="0 0 0.2025"/>
    <axis xyz="0 0 1"/>
    <limit effort="300" lower="-2.09439510239" upper="2.09439510239" velocity="10"/>
    <dynamics damping="0.5"/>
  </joint>
  
  <link name="iiwa_link_2">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0003 0.059 0.042"/>
      <mass value="6.35"/>
      <inertia ixx="0.0638" ixy="0.0001" ixz="0.00008" iyy="0.0416" iyz="0.0157" izz="0.0331"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://iiwa_simulation/meshes/iiwa14/visual/link_2.stl"/>
      </geometry>
      <material name="Orange"/>
    </visual>
  </link>

  <joint name="iiwa_joint_3" type="revolute">
    <parent link="iiwa_link_2"/>
    <child link="iiwa_link_3"/>
    <origin rpy="1.570796326794897 0 3.141592653589793" xyz="0 0.2045 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="300" lower="-2.96705972839" upper="2.96705972839" velocity="10"/>
    <dynamics damping="0.5"/>
  </joint>
  
  <link name="iiwa_link_3">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0.03 0.13"/>
      <mass value="3.5"/>
      <inertia ixx="0.0873" ixy="0" ixz="0" iyy="0.083" iyz="0.014" izz="0.0108"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://iiwa_simulation/meshes/iiwa14/visual/link_3.stl"/>
      </geometry>
      <material name="Orange"/>
    </visual>
  </link>

  <joint name="iiwa_joint_4" type="revolute">
    <parent link="iiwa_link_3"/>
    <child link="iiwa_link_4"/>
    <origin rpy="1.570796326794897 0 0" xyz="0 0 0.2155"/>
    <axis xyz="0 0 1"/>
    <limit effort="300" lower="-2.09439510239" upper="2.09439510239" velocity="10"/>
    <dynamics damping="0.5"/>
  </joint>
  
  <link name="iiwa_link_4">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0.067 0.034"/>
      <mass value="3.5"/>
      <inertia ixx="0.0368" ixy="0" ixz="0" iyy="0.02045" iyz="0.008" izz="0.02171"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://iiwa_simulation/meshes/iiwa14/visual/link_4.stl"/>
      </geometry>
      <material name="Orange"/>
    </visual>
  </link>

  <joint name="iiwa_joint_5" type="revolute">
    <parent link="iiwa_link_4"/>
    <child link="iiwa_link_5"/>
    <origin rpy="-1.570796326794897 3.141592653589793 0" xyz="0 0.1845 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="300" lower="-2.96705972839" upper="2.96705972839" velocity="10"/>
    <dynamics damping="0.5"/>
  </joint>
  
  <link name="iiwa_link_5">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0001 0.021 0.076"/>
      <mass value="3.5"/>
      <inertia ixx="0.0318" ixy="0.000007" ixz="0.000027" iyy="0.028916" iyz="0.005586" izz="0.006"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://iiwa_simulation/meshes/iiwa14/visual/link_5.stl"/>
      </geometry>
      <material name="Orange"/>
    </visual>
  </link>

  <joint name="iiwa_joint_6" type="revolute">
    <parent link="iiwa_link_5"/>
    <child link="iiwa_link_6"/>
    <origin rpy="1.570796326794897 0 0" xyz="0 0 0.2155"/>
    <axis xyz="0 0 1"/>
    <limit effort="300" lower="-2.09439510239" upper="2.09439510239" velocity="10"/>
    <dynamics damping="0.5"/>
  </joint>
  
  <link name="iiwa_link_6">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0.0006 0.0004"/>
      <mass value="1.8"/>
      <inertia ixx="0.0049" ixy="0" ixz="0" iyy="0.0047" iyz="0" izz="0.0036"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://iiwa_simulation/meshes/iiwa14/visual/link_6.stl"/>
      </geometry>
      <material name="Orange"/>
    </visual>
  </link>

  <joint name="iiwa_joint_7" type="revolute">
    <parent link="iiwa_link_6"/>
    <child link="iiwa_link_7"/>
    <origin rpy="-1.570796326794897 3.141592653589793 0" xyz="0 0.081 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="300" lower="-3.05432619099" upper="3.05432619099" velocity="10"/>
    <dynamics damping="0.5"/>
  </joint>
  
  <link name="iiwa_link_7">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <mass value="1.2"/>
      <inertia ixx="0.0055" ixy="0" ixz="0" iyy="0.0055" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://iiwa_simulation/meshes/iiwa14/visual/link_7.stl"/>
      </geometry>
      <material name="Grey"/>
    </visual>
  </link>

  <!-- Colorindo o robô no Gazebo Harmonic -->
  <gazebo reference="iiwa_link_0"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="iiwa_link_1"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="iiwa_link_2"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="iiwa_link_3"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="iiwa_link_4"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="iiwa_link_5"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="iiwa_link_6"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="iiwa_link_7"><material>Gazebo/Grey</material></gazebo>

<!-- Plugins de Força Bruta (Malha Aberta) para o iLQR -->
  <gazebo>
    <plugin filename="libignition-gazebo-apply-joint-force-system.so" name="ignition::gazebo::systems::ApplyJointForce">
      <joint_name>iiwa_joint_1</joint_name>
    </plugin>
    <plugin filename="libignition-gazebo-apply-joint-force-system.so" name="ignition::gazebo::systems::ApplyJointForce">
      <joint_name>iiwa_joint_2</joint_name>
    </plugin>
    <plugin filename="libignition-gazebo-apply-joint-force-system.so" name="ignition::gazebo::systems::ApplyJointForce">
      <joint_name>iiwa_joint_3</joint_name>
    </plugin>
    <plugin filename="libignition-gazebo-apply-joint-force-system.so" name="ignition::gazebo::systems::ApplyJointForce">
      <joint_name>iiwa_joint_4</joint_name>
    </plugin>
    <plugin filename="libignition-gazebo-apply-joint-force-system.so" name="ignition::gazebo::systems::ApplyJointForce">
      <joint_name>iiwa_joint_5</joint_name>
    </plugin>
    <plugin filename="libignition-gazebo-apply-joint-force-system.so" name="ignition::gazebo::systems::ApplyJointForce">
      <joint_name>iiwa_joint_6</joint_name>
    </plugin>
    <plugin filename="libignition-gazebo-apply-joint-force-system.so" name="ignition::gazebo::systems::ApplyJointForce">
      <joint_name>iiwa_joint_7</joint_name>
    </plugin>
    <!-- Sensores: Publicam os Ângulos Atuais -->
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher">
      <update_rate>1000</update_rate>
      <joint_name>iiwa_joint_1</joint_name>
      <joint_name>iiwa_joint_2</joint_name>
      <joint_name>iiwa_joint_3</joint_name>
      <joint_name>iiwa_joint_4</joint_name>
      <joint_name>iiwa_joint_5</joint_name>
      <joint_name>iiwa_joint_6</joint_name>
      <joint_name>iiwa_joint_7</joint_name>
    </plugin>
  </gazebo>

</robot>
